    "That’s your tempo as a classical term. Tap it to flip to the BPM number and back." : {
      "comment" : "A description of the tempo feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今のテンポをクラシックの速度記号で表しています。タップするとBPMの数字と切り替わります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist dein Tempo als klassische Bezeichnung. Tippe darauf, um zur BPM-Zahl und wieder zurück zu wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es tu tempo como término clásico. Tócalo para pasar al número de BPM y volver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是用古典音乐术语表示的速度。轻点即可在术语和 BPM 数字之间切换。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É o seu andamento com o nome clássico. Toque para trocar pelo número em BPM e voltar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est ton tempo sous son nom classique. Touche-le pour passer au nombre de BPM, et inversement."
