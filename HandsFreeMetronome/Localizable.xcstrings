    "Needs this app’s mic — turn off “I use iOS Voice Control” to use it." : {
      "comment" : "A description of why the user needs to allow the app to use the microphone.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potřebuje mikrofon této aplikace – vypněte „Používám Ovládání hlasem v iOS“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræver appens mikrofon – slå “Jeg bruger Stemmestyring i iOS” fra for at bruge den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht das Mikro dieser App – schalte dafür „Ich nutze die iOS-Sprachsteuerung“ aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειάζεται το μικρόφωνο της εφαρμογής — απενεργοποιήστε το «Χρησιμοποιώ τον Έλεγχο φωνής του iOS» για να το χρησιμοποιήσετε."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needs this app’s mic — turn off “I use iOS Voice Control” to use it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesita el micrófono de la app: desactiva “Uso Control por voz de iOS” para usarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitsee sovelluksen mikrofonin – poista käytöstä ”Käytän iOS:n Ääniohjausta”, jotta voit käyttää sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite le micro de l’app — désactive « J’utilise le Contrôle vocal d’iOS » pour t’en servir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memerlukan mikrofon aplikasi ini — matikan “Saya memakai Kontrol Suara iOS” untuk menggunakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve il microfono di questa app: disattiva “Uso il Controllo vocale di iOS” per usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリのマイクが必要です。「iOSの音声コントロールを使う」をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 마이크가 필요해요. 쓰려면 “iOS 음성 제어를 사용해요”를 꺼 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenger appens mikrofon – slå av «Jeg bruker Stemmestyring i iOS» for å bruke den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft de microfoon van deze app nodig — zet “Ik gebruik Spraakbediening van iOS” uit om dit te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymaga mikrofonu tej aplikacji — wyłącz „Używam Sterowania głosowego iOS”, aby z tego korzystać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisa do microfone deste app — desative “Uso o Controle por Voz do iOS” para usar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужен микрофон приложения — выключите «Я использую „Управление голосом“ iOS»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräver appens mikrofon – stäng av ”Jag använder röststyrning i iOS” för att använda den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้ไมค์ของแอปนี้ — ปิด “ฉันใช้การควบคุมด้วยเสียงของ iOS” เพื่อใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamanın mikrofonu gerekir; kullanmak için “iOS Sesle Denetim kullanıyorum” seçeneğini kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần micrô của ứng dụng này — hãy tắt “Tôi dùng Điều khiển bằng giọng nói của iOS” để dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用本 App 的麦克风。请先关闭“我在用 iOS 语音控制”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用本 App 的麥克風——請關閉「我使用 iOS 語音控制」。"
          }
        }
      }
    },
