    "Ask Siri or run a shortcut to start the click at your tempo." : {
      "comment" : "Roadmap item detail: shortcuts",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte Siri nebo spusťte zkratku a klikání začne ve vašem tempu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed Siri eller kør en genvej for at starte klikket i dit tempo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte Siri oder nutze einen Kurzbefehl, um den Klick in deinem Tempo zu starten."
