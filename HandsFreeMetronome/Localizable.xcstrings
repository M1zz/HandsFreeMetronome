          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il metronomo resta gratis. Pro aggiunge tre strumenti per esercitarti. Scegli l’abbonamento annuale o l’acquisto a vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
