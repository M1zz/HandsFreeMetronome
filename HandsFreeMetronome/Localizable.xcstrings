    "Play 2–5 notes, about half a second each." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2〜5音を、1音あたり約0.5秒ずつ鳴らしてください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiel 2–5 Töne, jeden etwa eine halbe Sekunde lang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca de 2 a 5 notas, de medio segundo cada una."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弹奏 2–5 个音，每个音约半秒。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque de 2 a 5 notas, cerca de meio segundo cada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue 2 à 5 notes, environ une demi-seconde chacune."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2~5개 음을 한 음당 0.5초 정도로 연주하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
