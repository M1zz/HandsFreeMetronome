    "Pick the words you’ll say. You can change this anytime in Voice Commands." : {
      "comment" : "Onboarding page 2 body above the English / own-language switch",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte slova, která budete říkat. Kdykoli to změníte v Hlasových příkazech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg de ord, du vil sige. Du kan altid ændre det under Stemmekommandoer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Wörter, die du sagst. Du kannst das jederzeit in den Sprachbefehlen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαλέξτε τις λέξεις που θα λέτε. Μπορείτε να το αλλάξετε όποτε θέλετε στις Φωνητικές εντολές."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the words you’ll say. You can change this anytime in Voice Commands."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige las palabras que vas a decir. Puedes cambiarlo cuando quieras en Comandos de voz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse sanat, joita sanot. Voit vaihtaa ne milloin tahansa Äänikomennoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis les mots que tu diras. Tu peux changer ça à tout moment dans Commandes vocales."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih kata yang akan Anda ucapkan. Anda bisa mengubahnya kapan saja di Perintah Suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli le parole che dirai. Puoi cambiarle quando vuoi in Comandi vocali."
