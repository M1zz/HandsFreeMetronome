    "On a foldable iPhone, see the beat and the controls side by side." : {
      "comment" : "Roadmap item detail: fold",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na skládacím iPhonu uvidíte dobu a ovládací prvky vedle sebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På en foldbar iPhone ser du slaget og betjeningen side om side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem faltbaren iPhone siehst du Takt und Bedienelemente nebeneinander."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε αναδιπλούμενο iPhone, δείτε τον χρόνο και τα χειριστήρια δίπλα-δίπλα."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a foldable iPhone, see the beat and the controls side by side."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un iPhone plegable, verás el pulso y los controles uno al lado del otro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taittuvalla iPhonella näet iskun ja säätimet vierekkäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un iPhone pliable, vois les temps et les commandes côte à côte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di iPhone lipat, lihat ketukan dan kontrol berdampingan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su un iPhone pieghevole, vedi i movimenti e i controlli affiancati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "折りたたみiPhoneでは、拍の表示と操作ボタンを左右に並べて使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더블 iPhone에서 박 보기와 조작부를 나란히 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På en foldbar iPhone ser du slaget og kontrollene side ved side."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op een opvouwbare iPhone zie je de tellen en de knoppen naast elkaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na składanym iPhonie zobaczysz uderzenia i przyciski obok siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPhone dobrável, veja as batidas e os controles lado a lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На складном iPhone доли и элементы управления располагаются рядом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På en vikbar iPhone ser du slaget och kontrollerna sida vid sida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บน iPhone แบบพับได้ จะเห็นจังหวะและปุ่มควบคุมเคียงข้างกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katlanabilir iPhone’da vuruşu ve denetimleri yan yana görün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên iPhone gập, xem phách và các nút điều khiển cạnh nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在折叠屏 iPhone 上，节拍显示和控制按钮并排呈现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在可摺疊 iPhone 上，並排顯示拍子與控制項。"
          }
        }
      }
    },
    "On iPad with a keyboard, start, stop, and change the tempo with keys." : {
      "comment" : "Roadmap item detail: a11y.keyboard",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPadu s klávesnicí spouštějte, zastavujte a měňte tempo klávesami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På iPad med tastatur kan du starte, stoppe og ændre tempoet med taster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am iPad mit Tastatur startest, stoppst und änderst du das Tempo per Taste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε iPad με πληκτρολόγιο, ξεκινήστε, σταματήστε και αλλάξτε την ταχύτητα με πλήκτρα."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On iPad with a keyboard, start, stop, and change the tempo with keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el iPad con teclado, inicia, detén y cambia el tempo con las teclas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadilla, jossa on näppäimistö, voit käynnistää, pysäyttää ja vaihtaa tempoa näppäimillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur iPad avec un clavier, lance, arrête et change le tempo avec les touches."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di iPad dengan keyboard, mulai, hentikan, dan ubah tempo dengan tombol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su iPad con tastiera, avvia, ferma e cambia il tempo con i tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadにキーボードをつなげば、開始・停止やテンポの変更をキーで操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드를 연결한 iPad에서 키로 시작, 정지, 템포 변경을 할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På iPad med tastatur kan du starte, stoppe og endre tempoet med taster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op een iPad met toetsenbord start, stop en wijzig je het tempo met toetsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPadzie z klawiaturą możesz uruchamiać, zatrzymywać i zmieniać tempo klawiszami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPad com teclado, inicie, pare e mude o andamento usando as teclas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPad с клавиатурой запускайте, останавливайте метроном и меняйте темп клавишами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På iPad med tangentbord startar, stoppar och ändrar du tempot med tangenterna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บน iPad ที่มีคีย์บอร์ด เริ่ม หยุด และเปลี่ยนความเร็วได้ด้วยปุ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klavyeli iPad’de tuşlarla başlatın, durdurun ve temposu değiştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên iPad có bàn phím, bắt đầu, dừng và đổi tốc độ bằng phím."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad 连接键盘后，用按键就能开始、停止和调整速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在連接鍵盤的 iPad 上，可用按鍵開始、停止並調整速度。"
          }
        }
      }
    },
