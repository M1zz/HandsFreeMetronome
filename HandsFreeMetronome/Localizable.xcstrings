    "A big beat and tempo you can read from a metre away, next to your score app. Change the tempo with a page-turn pedal." : {
      "comment" : "Roadmap item detail: ipad.stand",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velká doba a tempo čitelné z metru, hned vedle aplikace s notami. Tempo změníte pedálem pro otáčení stránek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stort slag og tempo, der kan ses på en meters afstand, ved siden af din node-app. Skift tempo med en bladvenderpedal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Großer Takt und großes Tempo, aus einem Meter lesbar – direkt neben deiner Noten-App. Das Tempo änderst du mit dem Blätterpedal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγάλος παλμός και ταχύτητα που διαβάζονται από ένα μέτρο, δίπλα στην εφαρμογή παρτιτούρας. Αλλάξτε ταχύτητα με πεντάλ γυρίσματος σελίδας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A big beat and tempo you can read from a metre away, next to your score app. Change the tempo with a page-turn pedal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pulso y un tempo grandes que se leen a un metro, junto a tu app de partituras. Cambia el tempo con un pedal de pasar página."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iso syke ja tempo, jotka näkee metrin päästä, nuottisovelluksen vieressä. Vaihda tempoa sivunkääntöpolkimella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pulsation et un tempo bien visibles à un mètre, à côté de votre app de partitions. Changez le tempo avec une pédale tourne-page."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketukan dan tempo besar yang terbaca dari jarak satu meter, di samping app partitur. Ubah tempo dengan pedal pembalik halaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battito e tempo grandi, leggibili a un metro, accanto alla tua app di spartiti. Cambia il tempo con un pedale voltapagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1メートル離れても読める大きな拍とテンポを、楽譜アプリの隣に。ページめくりペダルでテンポを変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1미터 떨어져도 읽히는 큰 박자와 템포를 악보 앱 옆에 띄워요. 페이지 넘김 페달로 템포를 바꿔요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stort slag og tempo som synes på en meters avstand, ved siden av note-appen. Endre tempoet med en bladvenderpedal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een grote tel en een groot tempo, leesbaar op een meter afstand, naast je bladmuziekapp. Wijzig het tempo met een bladeromslagpedaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duży puls i tempo czytelne z metra, obok aplikacji z nutami. Tempo zmienisz pedałem do przewracania stron."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsação e andamento grandes, legíveis a um metro, ao lado do seu app de partituras. Mude o andamento com um pedal de virar página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупные доли и темп видны с метра — прямо рядом с приложением для нот. Темп меняется педалью перелистывания."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stort slag och tempo som syns på en meters håll, bredvid notappen. Ändra tempot med en bladvändarpedal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จังหวะและความเร็วตัวใหญ่ อ่านได้จากระยะหนึ่งเมตร วางข้างแอปโน้ตเพลง เปลี่ยนความเร็วด้วยแป้นเหยียบพลิกหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir metre öteden okunan büyük vuruş ve tempo, nota uygulamanın hemen yanında. Tempoyu sayfa çevirme pedalıyla değiştir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhịp và tốc độ cỡ lớn, đọc được từ xa một mét, ngay cạnh ứng dụng bản nhạc. Đổi tốc độ bằng bàn đạp lật trang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一米外也看得清的大节拍和速度，就放在乐谱 App 旁边。用翻页踏板就能调速。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一公尺外也看得清的大節拍和速度，就放在樂譜 App 旁邊。用翻頁踏板就能調速。"
          }
        }
      }
    },
