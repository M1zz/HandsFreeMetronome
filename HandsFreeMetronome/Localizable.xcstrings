    "With Increase Contrast or Reduce Transparency on, beats, outlines and the help overlay are drawn bolder and solid." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「コントラストを上げる」や「透明度を下げる」をオンにすると、拍・枠線・ヘルプ表示がよりはっきり、不透明に表示されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Kontrast erhöhen“ oder „Transparenz reduzieren“ werden Schläge, Umrandungen und die Hilfe kräftiger und deckend dargestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Aumentar contraste o Reducir transparencia, los tiempos, los contornos y la ayuda en pantalla se ven más marcados y opacos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“增强对比度”或“降低透明度”后，节拍、轮廓线和帮助提示会显示得更粗、更不透明。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Aumentar Contraste ou Reduzir Transparência ativado, os tempos, os contornos e a ajuda na tela ficam mais fortes e opacos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Augmenter le contraste ou Réduire la transparence, les temps, les contours et l’aide à l’écran sont plus marqués et opaques."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비 증가나 투명도 줄이기를 켜면 박, 윤곽선, 도움말 오버레이가 더 굵고 단단하게 그려져요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「提高對比」或「降低透明度」時，拍子、輪廓與說明浮層會以更粗、更不透明的方式顯示。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Aumenta contrasto o Riduci trasparenza attivi, movimenti, contorni e guida a schermo sono più marcati e pieni."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Increase Contrast or Reduce Transparency on, beats, outlines and the help overlay are drawn bolder and solid."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено «Увеличение контраста» или «Понижение прозрачности», доли, контуры и подсказки отображаются жирнее и без прозрачности."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Verhoog contrast of Verminder transparantie aan worden tellen, contouren en de helpoverlay steviger en ondoorzichtig getekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączone jest Zwiększ kontrast lub Zmniejsz przezroczystość, uderzenia, kontury i nakładka pomocy są rysowane grubiej i bez przezroczystości."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrastı Artır veya Saydamlığı Azalt açıkken vuruşlar, kenar çizgileri ve yardım katmanı daha kalın ve opak çizilir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Öka kontrast eller Minska transparens på ritas slag, konturer och hjälplagret tydligare och ogenomskinliga."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Øg kontrast eller Reducer gennemsigtighed slået til tegnes slag, konturer og hjælpelaget federe og uigennemsigtigt."
          }
        }
      }
    },
