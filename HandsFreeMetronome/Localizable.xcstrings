    "The whole metronome stays free. Pro adds three practice tools. Choose yearly or lifetime." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celý metronom zůstává zdarma. Pro přidává tři nástroje na cvičení. Vyberte roční předplatné, nebo doživotní nákup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele metronomen er stadig gratis. Pro giver tre øveværktøjer. Vælg årligt abonnement eller livstid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ganze Metronom bleibt kostenlos. Pro bringt drei Übungswerkzeuge dazu. Wähle Jahresabo oder einmalig für immer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ολόκληρος ο μετρονόμος μένει δωρεάν. Το Pro προσθέτει τρία εργαλεία εξάσκησης. Επιλέξτε ετήσια συνδρομή ή εφ’ όρου ζωής."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
