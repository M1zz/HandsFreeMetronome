    "Say “practice” to raise the tempo automatically every few bars while you play — great for speed drills." : {
      "comment" : "A description of the practice tip.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「practice」と話すと、演奏中に数小節ごとにテンポが自動で上がります。スピード練習に最適です。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
