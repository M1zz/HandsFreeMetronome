        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點選即可在彈跳球與軌道圓環之間切換——或說「bounce」／「orbit」。"
          }
        },
        "it" : {
          "stringUnit" : {
