    "Tap 1/4, 1/8, Trip, or 1/16. Double-tap the card to open Accents and set every click of the measure high, low, or silent." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1/4、1/8、Trip、1/16をタップします。カードをダブルタップするとアクセントが開き、小節のクリックをひとつずつ高音・低音・無音に設定できます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf 1/4, 1/8, Trip oder 1/16. Tippe doppelt auf die Karte, um Akzente zu öffnen und jeden Klick im Takt auf hoch, tief oder stumm zu stellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca 1/4, 1/8, Trip o 1/16. Toca dos veces la tarjeta para abrir Acentos y poner cada clic del compás en agudo, grave o silencio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点 1/4、1/8、Trip 或 1/16。连按两下卡片可打开“重音”，为小节里的每一击设定高音、低音或静音。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em 1/4, 1/8, Trip ou 1/16. Toque duas vezes no cartão para abrir Acentos e deixar cada clique do compasso agudo, grave ou mudo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche 1/4, 1/8, Trip ou 1/16. Touche deux fois la carte pour ouvrir Accents et régler chaque clic de la mesure en aigu, grave ou muet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1/4, 1/8, 셋잇단, 1/16 중에서 탭하세요. 카드를 두 번 탭하면 악센트가 열려 마디의 모든 클릭을 높은 소리, 낮은 소리, 무음으로 정할 수 있어요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點選 1/4、1/8、三連音或 1/16。連點兩下卡片即可開啟重音，把小節中的每一下點擊設為高音、低音或靜音。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca 1/4, 1/8, Terzina o 1/16. Tocca due volte la scheda per aprire gli accenti e impostare ogni click della battuta su acuto, grave o silenzioso."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap 1/4, 1/8, Trip, or 1/16. Double-tap the card to open Accents and set every click of the measure high, low, or silent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите 1/4, 1/8, триоль или 1/16. Нажмите на карточку дважды, чтобы открыть акценты и задать каждому клику такта высокий, низкий или тихий звук."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op 1/4, 1/8, triool of 1/16. Tik twee keer op de kaart om Accenten te openen en elke klik van de maat op hoog, laag of stil te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij 1/4, 1/8, trioli lub 1/16. Dotknij dwukrotnie karty, aby otworzyć akcenty i ustawić każde kliknięcie taktu jako wysokie, niskie lub ciche."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1/4, 1/8, Üçlü veya 1/16’ya dokunun. Vurguları açmak ve ölçünün her tıkını tiz, pes veya sessiz yapmak için karta çift dokunun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på 1/4, 1/8, triol eller 1/16. Dubbeltryck på kortet för att öppna accenter och ställa in varje klick i takten som högt, lågt eller tyst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på 1/4, 1/8, triol eller 1/16. Dobbelttryk på kortet for at åbne accenter og sætte hvert klik i taktten til højt, lavt eller lydløst."
          }
        }
      }
    },
