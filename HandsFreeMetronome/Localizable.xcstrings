    "Saves this pattern with its meter and subdivision, so you can recall it per song." : {
      "comment" : "A message that appears when the user saves an accent pattern.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパターンを拍子・細分と一緒に保存し、曲ごとに呼び出せるようにします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert dieses Muster mit Taktart und Unterteilung, damit du es für jeden Song abrufen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda este patrón con su compás y su subdivisión para recuperarlo en cada canción."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连同拍号和细分一起保存此重音型，方便按曲目调用。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva este padrão com o compasso e a subdivisão, para você carregar de novo em cada música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre ce motif avec sa mesure et sa subdivision, pour le rappeler morceau par morceau."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패턴을 박자·분할과 함께 저장해 곡마다 불러올 수 있어요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此節奏型態連同拍號與細分一起儲存，之後可依歌曲叫出。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva questo schema con il suo tempo e la sua suddivisione, per richiamarlo brano per brano."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves this pattern with its metre and subdivision, so you can recall it per song."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет этот рисунок вместе с размером и дроблением, чтобы вызывать его для каждой пьесы."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart dit patroon samen met de maatsoort en onderverdeling, zodat je het per nummer kunt oproepen."
