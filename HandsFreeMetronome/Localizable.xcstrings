    "Say “start”, “stop”, “faster” or “tempo 120” and keep both hands on your instrument." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「start」「stop」「faster」「tempo 120」と話すだけ。両手は楽器から離さずに済みます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag „start“, „stop“, „faster“ oder „tempo 120“ – beide Hände bleiben am Instrument."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “start”, “stop”, “faster” o “tempo 120” y mantén las dos manos en tu instrumento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说“start”“stop”“faster”或“tempo 120”，双手不用离开乐器。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “start”, “stop”, “faster” ou “tempo 120” e mantenha as duas mãos no instrumento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis « start », « stop », « faster » ou « tempo 120 » et garde les deux mains sur ton instrument."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“start”, “stop”, “faster”, “tempo 120”이라고 말하면서 두 손은 악기에 두세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說「start」「stop」「faster」或「tempo 120」，雙手繼續放在樂器上。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dì “start”, “stop”, “faster” o “tempo 120” e tieni entrambe le mani sullo strumento."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say “start”, “stop”, “faster” or “tempo 120” and keep both hands on your instrument."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите «start», «stop», «faster» или «tempo 120» — обе руки остаются на инструменте."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg “start”, “stop”, “faster” of “tempo 120” en houd beide handen op je instrument."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz „start”, „stop”, „faster” lub „tempo 120” i trzymaj obie ręce na instrumencie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“start”, “stop”, “faster” veya “tempo 120” deyin, iki elinizi de enstrümanınızda tutun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
