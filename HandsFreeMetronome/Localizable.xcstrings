        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點選「聆聽」即可開啟或關閉語音控制。"
          }
        }
      }
    },
    "Tap Practice timer above Start, or say “%@”. It counts down while the click plays, then stops and chimes." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na časovač nad tlačítkem Start nebo řekněte „%@“. Odpočítává, dokud hraje klikání, pak se zastaví a zazvoní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på timeren over Start, eller sig “%@”. Den tæller ned, mens klikket spiller, og stopper så med en lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Timer über Start oder sag „%@“. Er läuft, solange der Klick spielt, und stoppt dann mit einem Gong."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το χρονόμετρο πάνω από την Έναρξη ή πείτε «%@». Μετρά αντίστροφα όσο παίζει το κλικ και μετά σταματά και ηχεί."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Practice timer above Start, or say “%@”. It counts down while the click plays, then stops and chimes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el temporizador encima de Iniciar o di “%@”. Cuenta atrás mientras suena el clic y luego se detiene con un aviso sonoro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta Aloita-painikkeen yllä olevaa ajastinta tai sano ”%@”. Se laskee alaspäin naksahduksen soidessa, pysähtyy ja kilahtaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le minuteur au-dessus de Démarrer ou dites « %@ ». Il décompte pendant que le clic joue, puis s’arrête avec un carillon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk timer di atas tombol Mulai, atau ucapkan “%@”. Timer menghitung mundur selama klik berbunyi, lalu berhenti dan berdenting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il timer sopra Avvia, oppure dì “%@”. Il conto alla rovescia procede mentre suona il click, poi si ferma con un suono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタートの上のタイマーをタップするか、“%@”と言います。クリックが鳴っている間だけカウントダウンし、終わると止まってチャイムが鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작 버튼 위의 타이머를 탭하거나 “%@”라고 말하세요. 클릭이 울리는 동안 카운트다운하고, 끝나면 멈추고 알림음이 울려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på timeren over Start, eller si «%@». Den teller ned mens klikket spilles, og stopper deretter med et lydsignal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de timer boven Start of zeg “%@”. Hij telt af terwijl de klik speelt, stopt daarna en laat een geluidje horen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij minutnika nad przyciskiem Start albo powiedz „%@”. Odlicza, gdy gra klik, po czym zatrzymuje się i dzwoni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no timer acima de Iniciar ou diga “%@”. Ele conta enquanto o clique toca e depois para com um aviso sonoro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите таймер над кнопкой «Старт» или скажите «%@». Отсчёт идёт, пока звучит клик, затем метроном останавливается и звенит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på timern ovanför Starta eller säg ”%@”. Den räknar ner medan klicket spelas och stoppar sedan med en ljudsignal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะตัวตั้งเวลาเหนือปุ่มเริ่ม หรือพูดว่า “%@” ตัวตั้งเวลาจะนับถอยหลังขณะเสียงคลิกเล่น แล้วหยุดพร้อมส่งเสียงเตือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlat düğmesinin üstündeki zamanlayıcıya dokunun veya “%@” deyin. Tık çalarken geri sayar, sonra durur ve zil çalar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm hẹn giờ phía trên nút Bắt đầu, hoặc nói “%@”. Bộ đếm lùi khi tiếng gõ phát, rồi dừng và reo chuông."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点开始按钮上方的计时器，或说“%@”。节拍播放时倒计时，结束后停止并响起提示音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點選開始按鈕上方的計時器，或說「%@」。點擊聲播放時會倒數，時間到會停止並響起提示音。"
          }
        }
      }
    },
