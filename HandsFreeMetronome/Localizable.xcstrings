    "Page-turn pedal: right is faster, left is slower. Keyboard: → ← and Space to start or stop." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedál pro otáčení stránek: pravý zrychlí, levý zpomalí. Klávesnice: → ← a mezerník pro spuštění či zastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bladvenderpedal: højre er hurtigere, venstre langsommere. Tastatur: → ← og mellemrum for at starte eller stoppe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blätterpedal: rechts schneller, links langsamer. Tastatur: → ← und Leertaste zum Starten und Stoppen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πεντάλ γυρίσματος σελίδας: δεξί πιο γρήγορα, αριστερό πιο αργά. Πληκτρολόγιο: → ← και διάστημα για έναρξη ή διακοπή."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page-turn pedal: right is faster, left is slower. Keyboard: → ← and Space to start or stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedal de pasar página: derecha más rápido, izquierda más lento. Teclado: → ← y espacio para iniciar o detener."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sivunkääntöpoljin: oikea nopeuttaa, vasen hidastaa. Näppäimistö: → ← ja välilyönti käynnistää tai pysäyttää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pédale tourne-page : droite plus vite, gauche plus lent. Clavier : → ← et Espace pour démarrer ou arrêter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedal pembalik halaman: kanan lebih cepat, kiri lebih lambat. Keyboard: → ← dan Spasi untuk mulai atau berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedale voltapagina: destro più veloce, sinistro più lento. Tastiera: → ← e Spazio per avviare o fermare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページめくりペダル：右で速く、左で遅く。キーボード：→ ← で調整、スペースでスタート／ストップ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지 넘김 페달: 오른쪽은 빠르게, 왼쪽은 느리게. 키보드: → ← 그리고 스페이스로 시작·정지."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bladvenderpedal: høyre er raskere, venstre saktere. Tastatur: → ← og mellomrom for å starte eller stoppe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bladeromslagpedaal: rechts sneller, links langzamer. Toetsenbord: → ← en spatie om te starten of te stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedał do przewracania stron: prawy szybciej, lewy wolniej. Klawiatura: → ← i spacja, by uruchomić lub zatrzymać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedal de virar página: direita acelera, esquerda desacelera. Teclado: → ← e Espaço para iniciar ou parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Педаль перелистывания: правая быстрее, левая медленнее. Клавиатура: → ← и пробел — старт и стоп."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bladvändarpedal: höger snabbare, vänster långsammare. Tangentbord: → ← och mellanslag för att starta eller stoppa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แป้นเหยียบพลิกหน้า: ขวาเร็วขึ้น ซ้ายช้าลง คีย์บอร์ด: → ← และ Space เพื่อเริ่มหรือหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfa çevirme pedalı: sağ hızlandırır, sol yavaşlatır. Klavye: → ← ve başlatıp durdurmak için Boşluk."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bàn đạp lật trang: phải nhanh hơn, trái chậm hơn. Bàn phím: → ← và phím cách để bắt đầu hoặc dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻页踏板：右踩加快，左踩放慢。键盘：→ ← 调速，空格键开始或停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻頁踏板：右踩加快，左踩放慢。鍵盤：→ ← 調速，空白鍵開始或停止。"
          }
        }
      }
    },
