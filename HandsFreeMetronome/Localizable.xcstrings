    "The screen stays readable and tidy at the very largest text sizes." : {
      "comment" : "Roadmap item detail: a11y.largetext",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大の文字サイズでも、画面が崩れず読みやすく表示されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei den allergrößten Schriftgrößen bleibt alles lesbar und aufgeräumt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla se mantiene clara y ordenada incluso con los tamaños de letra más grandes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使用最大的字号，界面也清晰整齐。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela continua legível e organizada até nos maiores tamanhos de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran reste lisible et bien rangé, même avec les plus grandes tailles de texte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 큰 글자 크기에서도 화면이 읽기 쉽고 깔끔하게 유지돼요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使在最大的文字大小下，畫面仍然清楚易讀、整齊不亂。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
