    "Needs this app’s mic — turn off “I use iOS Voice Control” to use it." : {
      "comment" : "A description of why the user needs to allow the app to use the microphone.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリのマイクが必要です。「iOSの音声コントロールを使う」をオフにしてください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht das Mikro dieser App – schalte dafür „Ich nutze die iOS-Sprachsteuerung“ aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesita el micrófono de la app: desactiva “Uso Control por voz de iOS” para usarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用本 App 的麦克风。请先关闭“我在用 iOS 语音控制”。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisa do microfone deste app — desative “Uso o Controle por Voz do iOS” para usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite le micro de l’app — désactive « J’utilise le Contrôle vocal d’iOS » pour t’en servir."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 마이크가 필요해요. 쓰려면 “iOS 음성 제어를 사용해요”를 꺼 주세요."
