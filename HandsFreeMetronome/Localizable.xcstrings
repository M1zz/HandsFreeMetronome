          "stringUnit" : {
            "state" : "translated",
            "value" : "Dì “start”, “stop”, “faster” o “tempo 120” e tieni entrambe le mani sullo strumento."
          }
        }
      }
    },
    "Commands are English words" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
