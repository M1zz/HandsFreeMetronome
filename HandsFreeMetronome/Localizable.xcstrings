            "value" : "Toque em Ouvir para ligar ou desligar o controle por voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Слушать», чтобы включить или выключить голосовое управление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
