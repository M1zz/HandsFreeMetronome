          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche pour passer de la balle qui rebondit à l’anneau en orbite — ou dis « bounce » / « orbit »."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭하면 튀는 공과 오빗 링이 전환돼요. “bounce” / “orbit”이라고 말해도 됩니다."
