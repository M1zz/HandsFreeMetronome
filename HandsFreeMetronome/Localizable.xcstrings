          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε «%1$@» όποτε θέλετε — ή πατήστε εδώ — για να δείτε όλες τις εντολές και μετά «%2$@» για κλείσιμο."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say “%1$@” anytime — or tap here — to see every command you can say, then “%2$@” to dismiss."
