        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el metrónomo sigue siendo gratis. Pro añade tres herramientas de práctica. Elige suscripción anual o de por vida."
          }
        },
        "fi" : {
          "stringUnit" : {
