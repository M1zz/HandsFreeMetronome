        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo schermo resta leggibile e in ordine anche con le dimensioni di testo più grandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大の文字サイズでも、画面が崩れず読みやすく表示されます。"
