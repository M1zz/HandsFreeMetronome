      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクはすでに聞き取り中です。「start」「faster」「help」と話してみてください。iOSの音声コントロールを使う場合は、「音声コマンド」を開いて切り替えます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikro hört schon zu – sag „start“, „faster“ oder „help“. Du nutzt die iOS-Sprachsteuerung? Öffne die Sprachbefehle, um umzustellen."
