    "At the largest text sizes, buttons and lists rearrange so nothing gets cut off." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "とても大きな文字サイズでは、ボタンやリストの並びが変わり、文字が切れなくなりました。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei den größten Schriftgrößen ordnen sich Tasten und Listen neu an, damit nichts abgeschnitten wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con los tamaños de texto más grandes, los botones y las listas se reorganizan para que nada quede cortado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
