    "Turns off the app's own microphone and drives controls by name" : {
      "comment" : "A hint for the user that toggling the mic will disable voice control.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのマイクをオフにし、コントロール名で操作します"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet das Mikro der App aus und steuert die Bedienelemente über ihre Namen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga el micrófono de la app y maneja los controles por su nombre"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭本 App 的麦克风，改为按名称操作控件"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliga o microfone do app e aciona os controles pelo nome"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le micro de l’app et pilote les commandes par leur nom"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 자체 마이크를 끄고 이름으로 조작합니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉本 App 自己的麥克風，改以按鈕名稱操作"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spegne il microfono dell’app e controlla i pulsanti per nome"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns off the app's own microphone and drives controls by name"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключает микрофон приложения; кнопками можно управлять по названию"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de eigen microfoon van de app uit; bedien de knoppen op naam"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącza mikrofon aplikacji; przyciskami steruje się po nazwie"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın kendi mikrofonunu kapatır; düğmeler adlarıyla yönetilir"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger av appens egen mikrofon och styr knapparna med deras namn"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår appens egen mikrofon fra og styrer knapperne ved navn"
          }
        }
      }
    },
    "Turns off this app’s mic so the two don’t clash. Control it by saying “Tap Start”, “Tap Faster”, “Tap 3 beats”." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "競合しないよう、このアプリのマイクをオフにします。「スタートをタップ」「速くをタップ」「3拍をタップ」と話して操作します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet das Mikro dieser App aus, damit sich beide nicht stören. Steuere sie dann mit „Tippe auf Start“, „Tippe auf Schneller“, „Tippe auf 3 Schläge“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga el micrófono de esta app para que no interfieran. Contrólala diciendo “Toca Iniciar”, “Toca Más rápido”, “Toca 3 tiempos”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭本 App 的麦克风，避免两者冲突。说“轻点开始”“轻点加快”“轻点 3 拍”即可操作。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliga o microfone deste app para os dois não conflitarem. Controle dizendo “Toque em Iniciar”, “Toque em Mais rápido”, “Toque em 3 tempos”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le micro de l’app pour éviter les conflits. Pilote-la en disant « Touche Démarrer », « Touche Plus vite », « Touche 3 temps »."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 마이크를 꺼서 두 기능이 충돌하지 않게 해요. “Tap Start”, “Tap Faster”, “Tap 3 beats”라고 말해 조작하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉本 App 的麥克風，以免兩者衝突。請說「Tap Start」「Tap Faster」「Tap 3 beats」來操作。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spegne il microfono di questa app per evitare conflitti. Controllala dicendo “Tap Start”, “Tap Faster”, “Tap 3 beats”."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns off this app’s mic so the two don’t clash. Control it by saying “Tap Start”, “Tap Faster”, “Tap 3 beats”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключает микрофон приложения, чтобы они не мешали друг другу. Управляйте командами «Tap Start», «Tap Faster», «Tap 3 beats»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de microfoon van deze app uit, zodat ze elkaar niet in de weg zitten. Bedien de app met “Tap Start”, “Tap Faster” of “Tap 3 beats”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącza mikrofon tej aplikacji, aby się nie zakłócały. Steruj, mówiąc „Tap Start”, „Tap Faster”, „Tap 3 beats”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkisi çakışmasın diye bu uygulamanın mikrofonunu kapatır. “Tap Start”, “Tap Faster”, “Tap 3 beats” diyerek yönetin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger av appens mikrofon så att de inte krockar. Styr genom att säga ”Tap Start”, ”Tap Faster”, ”Tap 3 beats”."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
