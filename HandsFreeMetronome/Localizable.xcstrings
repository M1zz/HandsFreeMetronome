    "Turns off the app's own microphone and drives controls by name" : {
      "comment" : "A hint for the user that toggling the mic will disable voice control.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのマイクをオフにし、コントロール名で操作します"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet das Mikro der App aus und steuert die Bedienelemente über ihre Namen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga el micrófono de la app y maneja los controles por su nombre"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭本 App 的麦克风，改为按名称操作控件"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliga o microfone do app e aciona os controles pelo nome"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le micro de l’app et pilote les commandes par leur nom"
          }
        }
      }
    },
    "Turns off this app’s mic so the two don’t clash. Control it by saying “Tap Start”, “Tap Faster”, “Tap 3 beats”." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "競合しないよう、このアプリのマイクをオフにします。「スタートをタップ」「速くをタップ」「3拍をタップ」と話して操作します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet das Mikro dieser App aus, damit sich beide nicht stören. Steuere sie dann mit „Tippe auf Start“, „Tippe auf Schneller“, „Tippe auf 3 Schläge“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga el micrófono de esta app para que no interfieran. Contrólala diciendo “Toca Iniciar”, “Toca Más rápido”, “Toca 3 tiempos”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭本 App 的麦克风，避免两者冲突。说“轻点开始”“轻点加快”“轻点 3 拍”即可操作。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliga o microfone deste app para os dois não conflitarem. Controle dizendo “Toque em Iniciar”, “Toque em Mais rápido”, “Toque em 3 tempos”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le micro de l’app pour éviter les conflits. Pilote-la en disant « Touche Démarrer », « Touche Plus vite », « Touche 3 temps »."
          }
        }
      }
    },
