    "Counts like how many devices use the app and crash reports. No audio, settings or personal information. Applies from the next launch." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを使っている端末の数などの集計とクラッシュレポートです。音声・設定・個人情報は送りません。次回の起動から反映されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlen wie die Anzahl der Geräte, die die App nutzen, und Absturzberichte. Kein Audio, keine Einstellungen, keine persönlichen Daten. Gilt ab dem nächsten Start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuentos como cuántos dispositivos usan la app e informes de fallos. Sin audio, ajustes ni datos personales. Se aplica desde el próximo inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des comptages comme le nombre d’appareils qui utilisent l’app, et des rapports de plantage. Ni audio, ni réglages, ni données personnelles. Pris en compte au prochain lancement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如使用本应用的设备数量等统计，以及崩溃报告。不包含音频、设置或个人信息。下次启动时生效。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contagens como quantos dispositivos usam o app e relatórios de falhas. Sem áudio, ajustes ou dados pessoais. Vale a partir da próxima abertura."
          }
        }
      }
    },
