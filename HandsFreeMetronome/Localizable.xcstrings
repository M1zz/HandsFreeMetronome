    "In every language, you control the app with short English words. Say “help” anytime to see them all on screen." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの言語でも、短い英単語でアプリを操作します。いつでも「help」と言えば、使えるコマンドが画面に表示されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In jeder Sprache steuerst du die App mit kurzen englischen Wörtern. Sag jederzeit „help“, um alle auf dem Bildschirm zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cualquier idioma, controlas la app con palabras cortas en inglés. Di “help” cuando quieras para verlas todas en pantalla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论使用哪种语言，都用简短的英文单词控制 App。随时说“help”，即可在屏幕上看到全部指令。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em qualquer idioma, você controla o app com palavras curtas em inglês. Diga “help” a qualquer momento para ver todas na tela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle que soit la langue, tu pilotes l’app avec de courts mots anglais. Dis « help » à tout moment pour les voir toutes à l’écran."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 언어에서든 짧은 영어 단어로 앱을 조작해요. 언제든 “help”라고 말하면 모든 명령이 화면에 나와요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不論使用哪種語言，都是用簡短的英文單字來操控 App。隨時說「help」，就能在畫面上看到全部指令。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ogni lingua, controlli l’app con brevi parole inglesi. Dì “help” in qualsiasi momento per vederle tutte sullo schermo."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In every language, you control the app with short English words. Say “help” anytime to see them all on screen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На любом языке приложением управляют короткие английские слова. Скажите «help» в любой момент, чтобы увидеть их все на экране."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In elke taal bedien je de app met korte Engelse woorden. Zeg op elk moment “help” om ze allemaal op het scherm te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W każdym języku aplikacją steruje się krótkimi angielskimi słowami. Powiedz „help” w dowolnej chwili, aby zobaczyć je wszystkie na ekranie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her dilde uygulamayı kısa İngilizce sözcüklerle yönetirsiniz. Hepsini ekranda görmek için istediğiniz an “help” deyin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På alla språk styr du appen med korta engelska ord. Säg ”help” när som helst för att se dem alla på skärmen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På alle sprog styrer du appen med korte engelske ord. Sig “help” når som helst for at se dem alle på skærmen."
          }
        }
      }
    },
    "The app’s own mic stays off so it won’t clash with Voice Control. Say “Tap Start” or “Tap Faster”." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声コントロールと競合しないよう、アプリのマイクはオフのままです。「スタートをタップ」「速くをタップ」のように話してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikro der App bleibt aus, damit es der Sprachsteuerung nicht in die Quere kommt. Sag „Tippe auf Start“ oder „Tippe auf Schneller“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono de la app se queda apagado para no interferir con Control por voz. Di “Toca Iniciar” o “Toca Más rápido”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本 App 的麦克风保持关闭，不会与语音控制冲突。请说“轻点开始”或“轻点加快”。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone do app fica desligado para não conflitar com o Controle por Voz. Diga “Toque em Iniciar” ou “Toque em Mais rápido”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro de l’app reste coupé pour ne pas gêner le Contrôle vocal. Dis « Touche Démarrer » ou « Touche Plus vite »."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 자체 마이크는 꺼져 있어 음성 제어와 충돌하지 않아요. “Tap Start” 또는 “Tap Faster”라고 말해 보세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本 App 自己的麥克風保持關閉，以免與語音控制衝突。請說「Tap Start」或「Tap Faster」。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono dell’app resta spento per non andare in conflitto con il Controllo vocale. Dì “Tap Start” o “Tap Faster”."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app’s own mic stays off so it won’t clash with Voice Control. Say “Tap Start” or “Tap Faster”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон приложения остаётся выключенным, чтобы не мешать «Управлению голосом». Скажите «Tap Start» или «Tap Faster»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eigen microfoon van de app blijft uit, zodat hij Spraakbediening niet in de weg zit. Zeg “Tap Start” of “Tap Faster”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon aplikacji pozostaje wyłączony, aby nie kolidował ze Sterowaniem głosowym. Powiedz „Tap Start” lub „Tap Faster”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesle Denetim ile çakışmaması için uygulamanın kendi mikrofonu kapalı kalır. “Tap Start” veya “Tap Faster” deyin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens egen mikrofon förblir av så att den inte krockar med röststyrningen. Säg ”Tap Start” eller ”Tap Faster”."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens egen mikrofon forbliver slået fra, så den ikke kolliderer med Stemmestyring. Sig “Tap Start” eller “Tap Faster”."
          }
        }
      }
    },
