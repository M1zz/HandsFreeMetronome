    "Counts like how many devices use the app and crash reports. No audio, settings or personal information. Applies from the next launch." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを使っている端末の数などの集計とクラッシュレポートです。音声・設定・個人情報は送りません。次回の起動から反映されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlen wie die Anzahl der Geräte, die die App nutzen, und Absturzberichte. Kein Audio, keine Einstellungen, keine persönlichen Daten. Gilt ab dem nächsten Start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuentos como cuántos dispositivos usan la app e informes de fallos. Sin audio, ajustes ni datos personales. Se aplica desde el próximo inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des comptages comme le nombre d’appareils qui utilisent l’app, et des rapports de plantage. Ni audio, ni réglages, ni données personnelles. Pris en compte au prochain lancement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如使用本应用的设备数量等统计，以及崩溃报告。不包含音频、设置或个人信息。下次启动时生效。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contagens como quantos dispositivos usam o app e relatórios de falhas. Sem áudio, ajustes ou dados pessoais. Vale a partir da próxima abertura."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 쓰는 기기 수, 비정상 종료 보고서 같은 집계예요. 오디오, 설정, 개인 정보는 포함되지 않아요. 다음 실행부터 적용돼요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如有多少裝置在使用本 App，以及當機報告。不含音訊、設定或個人資訊。下次啟動時生效。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati come quanti dispositivi usano l’app e i rapporti sugli arresti anomali. Nessun audio, impostazione o dato personale. Vale dal prossimo avvio."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts like how many devices use the app and crash reports. No audio, settings or personal information. Applies from the next launch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только счётчики — например, сколько устройств используют приложение, — и отчёты о сбоях. Никакого звука, настроек и личных данных. Вступает в силу со следующего запуска."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tellingen zoals hoeveel apparaten de app gebruiken, plus crashrapporten. Geen audio, instellingen of persoonlijke gegevens. Geldt vanaf de volgende keer opstarten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczniki, np. ile urządzeń używa aplikacji, oraz raporty o awariach. Bez dźwięku, ustawień i danych osobowych. Obowiązuje od następnego uruchomienia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı kaç cihazın kullandığı gibi sayımlar ve çökme raporları. Ses, ayar veya kişisel bilgi yok. Bir sonraki açılıştan itibaren geçerli olur."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räknare, till exempel hur många enheter som använder appen, samt kraschrapporter. Inget ljud, inga inställningar och ingen personlig information. Gäller från nästa start."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tællere som fx hvor mange enheder der bruger appen, og nedbrudsrapporter. Ingen lyd, indstillinger eller personlige oplysninger. Gælder fra næste start."
          }
        }
      }
    },
