          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε «%1$@», «%2$@», «%3$@» ή «%4$@» και κρατήστε και τα δύο χέρια στο όργανό σας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say “%1$@”, “%2$@”, “%3$@” or “%4$@” and keep both hands on your instrument."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “%1$@”, “%2$@”, “%3$@” o “%4$@” y mantén las dos manos en tu instrumento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano ”%1$@”, ”%2$@”, ”%3$@” tai ”%4$@” ja pidä molemmat kädet soittimellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis « %1$@ », « %2$@ », « %3$@ » ou « %4$@ » et garde les deux mains sur ton instrument."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapkan “%1$@”, “%2$@”, “%3$@”, atau “%4$@” dan biarkan kedua tangan tetap di instrumenmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dì “%1$@”, “%2$@”, “%3$@” o “%4$@” e tieni entrambe le mani sullo strumento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」「%2$@」「%3$@」「%4$@」と話すだけ。両手は楽器から離さずに済みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”, “%2$@”, “%3$@”, “%4$@”이라고 말하면서 두 손은 악기에 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si «%1$@», «%2$@», «%3$@» eller «%4$@», og ha begge hendene på instrumentet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg “%1$@”, “%2$@”, “%3$@” of “%4$@” en houd beide handen op je instrument."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz „%1$@”, „%2$@”, „%3$@” lub „%4$@” i trzymaj obie ręce na instrumencie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “%1$@”, “%2$@”, “%3$@” ou “%4$@” e mantenha as duas mãos no instrumento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите «%1$@», «%2$@», «%3$@» или «%4$@» — обе руки остаются на инструменте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg ”%1$@”, ”%2$@”, ”%3$@” eller ”%4$@” och ha båda händerna kvar på instrumentet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดว่า “%1$@”, “%2$@”, “%3$@” หรือ “%4$@” แล้วเก็บมือทั้งสองไว้บนเครื่องดนตรี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”, “%2$@”, “%3$@” veya “%4$@” deyin, iki elinizi de enstrümanınızda tutun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói “%1$@”, “%2$@”, “%3$@” hoặc “%4$@” và giữ cả hai tay trên nhạc cụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说“%1$@”“%2$@”“%3$@”或“%4$@”，双手不用离开乐器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說「%1$@」「%2$@」「%3$@」或「%4$@」，雙手繼續放在樂器上。"
          }
        }
      }
