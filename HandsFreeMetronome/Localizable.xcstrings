        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapkan “%1$@” kapan saja — atau ketuk di sini — untuk melihat semua perintah yang bisa diucapkan, lalu “%2$@” untuk menutup."
