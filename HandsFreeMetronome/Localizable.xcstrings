          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat lempeän muistutuksen valitsemanasi harjoitusaikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reçois un petit rappel à l’heure choisie pour t’exercer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan pengingat lembut pada waktu yang kamu pilih untuk berlatih."
