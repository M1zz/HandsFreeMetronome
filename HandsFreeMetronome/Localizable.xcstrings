    "The mic is already listening — say “%@”, “%@”, or “%@”. Use iOS Voice Control? Open Voice Commands to switch." : {
      "comment" : "A tip for users who are using a mic for the first time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon už poslouchá – řekněte „%1$@“, „%2$@“ nebo „%3$@“. Používáte Ovládání hlasem v iOS? Přepněte v Hlasových příkazech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen lytter allerede – sig “%1$@”, “%2$@” eller “%3$@”. Bruger du Stemmestyring i iOS? Åbn Stemmekommandoer for at skifte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikro hört schon zu – sag „%1$@“, „%2$@“ oder „%3$@“. Du nutzt die iOS-Sprachsteuerung? Öffne die Sprachbefehle, um umzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μικρόφωνο ακούει ήδη — πείτε «%1$@», «%2$@» ή «%3$@». Χρησιμοποιείτε τον Έλεγχο φωνής του iOS; Ανοίξτε τις Φωνητικές εντολές για εναλλαγή."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mic is already listening — say “%1$@”, “%2$@”, or “%3$@”. Use iOS Voice Control? Open Voice Commands to switch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono ya está escuchando: di “%1$@”, “%2$@” o “%3$@”. ¿Usas Control por voz de iOS? Abre Comandos de voz para cambiar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofoni kuuntelee jo – sano ”%1$@”, ”%2$@” tai ”%3$@”. Käytätkö iOS:n Ääniohjausta? Vaihda avaamalla Äänikomennot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro écoute déjà — dis « %1$@ », « %2$@ » ou « %3$@ ». Tu utilises le Contrôle vocal d’iOS ? Ouvre Commandes vocales pour basculer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon sudah mendengarkan — ucapkan “%1$@”, “%2$@”, atau “%3$@”. Memakai Kontrol Suara iOS? Buka Perintah Suara untuk beralih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono è già in ascolto: dì “%1$@”, “%2$@” o “%3$@”. Usi il Controllo vocale di iOS? Apri Comandi vocali per cambiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクはすでに聞き取り中です。「%1$@」「%2$@」「%3$@」と話してみてください。iOSの音声コントロールを使う場合は、「音声コマンド」を開いて切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크가 이미 듣고 있어요. “%1$@”, “%2$@”, “%3$@”라고 말해 보세요. iOS 음성 제어를 쓰시나요? 음성 명령에서 전환하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen lytter allerede – si «%1$@», «%2$@» eller «%3$@». Bruker du Stemmestyring i iOS? Åpne Stemmekommandoer for å bytte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De microfoon luistert al — zeg “%1$@”, “%2$@” of “%3$@”. Gebruik je Spraakbediening van iOS? Open Spraakcommando’s om te wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon już słucha — powiedz „%1$@”, „%2$@” lub „%3$@”. Używasz Sterowania głosowego iOS? Otwórz Polecenia głosowe, aby przełączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone já está ouvindo — diga “%1$@”, “%2$@” ou “%3$@”. Usa o Controle por Voz do iOS? Abra Comandos de voz para trocar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон уже слушает: скажите «%1$@», «%2$@» или «%3$@». Пользуетесь «Управлением голосом» iOS? Откройте «Голосовые команды», чтобы переключиться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen lyssnar redan – säg ”%1$@”, ”%2$@” eller ”%3$@”. Använder du röststyrning i iOS? Öppna Röstkommandon för att byta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไมค์กำลังฟังอยู่ พูดว่า “%1$@”, “%2$@” หรือ “%3$@” ใช้การควบคุมด้วยเสียงของ iOS อยู่ใช่ไหม เปิดคำสั่งเสียงเพื่อสลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon zaten dinliyor: “%1$@”, “%2$@” veya “%3$@” deyin. iOS Sesle Denetim mi kullanıyorsunuz? Geçmek için Sesli Komutlar’ı açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Micrô đang nghe — hãy nói “%1$@”, “%2$@” hoặc “%3$@”. Bạn dùng Điều khiển bằng giọng nói của iOS? Mở Lệnh giọng nói để chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风已在聆听，说“%1$@”“%2$@”或“%3$@”即可。在用 iOS 语音控制？打开“语音指令”进行切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麥克風已在聆聽——請說「%1$@」「%2$@」或「%3$@」。使用 iOS 語音控制嗎？請開啟「語音指令」進行切換。"
          }
        }
      }
    },
    "The screen stays readable and tidy at the very largest text sizes." : {
      "comment" : "Roadmap item detail: a11y.largetext",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazovka zůstane čitelná a přehledná i při největších velikostech textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmen forbliver læsbar og ryddelig, selv med de allerstørste tekststørrelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei den allergrößten Schriftgrößen bleibt alles lesbar und aufgeräumt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η οθόνη παραμένει ευανάγνωστη και τακτοποιημένη ακόμα και στα μεγαλύτερα μεγέθη κειμένου."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The screen stays readable and tidy at the very largest text sizes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla se mantiene clara y ordenada incluso con los tamaños de letra más grandes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttö pysyy luettavana ja siistinä suurimmillakin tekstikoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran reste lisible et bien rangé, même avec les plus grandes tailles de texte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar tetap terbaca dan rapi bahkan pada ukuran teks terbesar."
