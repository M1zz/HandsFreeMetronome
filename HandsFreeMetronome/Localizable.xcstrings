        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “%1$@” cuando quieras (o toca aquí) para ver todos los comandos que puedes decir, y luego “%2$@” para cerrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano ”%1$@” milloin tahansa – tai napauta tästä – nähdäksesi kaikki komennot ja sulje sitten sanomalla ”%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis « %1$@ » à tout moment — ou touche ici — pour voir toutes les commandes possibles, puis « %2$@ » pour fermer."
