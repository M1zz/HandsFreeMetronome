    "After an update, see what’s new the first time you open the app." : {
      "comment" : "Roadmap item detail: whatsnew",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po aktualizaci uvidíte při prvním otevření aplikace, co je nového."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter en opdatering kan du se, hvad der er nyt, første gang du åbner appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
