        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정한 시간에 연습하라는 부드러운 알림을 받아 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
