    "Got a code for Pro? Enter it right in the app, on the Pro screen or under Voice Commands." : {
      "comment" : "What's new 1.0.10: offer code detail",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte kód pro Pro? Zadejte ho přímo v aplikaci, na obrazovce Pro nebo v Hlasových příkazech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du en kode til Pro? Indtast den direkte i appen, på Pro-skærmen eller under Stemmekommandoer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast einen Code für Pro? Gib ihn direkt in der App ein – im Pro-Bildschirm oder unter Sprachbefehle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχετε κωδικό για το Pro; Εισαγάγετε τον απευθείας στην εφαρμογή, στην οθόνη Pro ή στις Φωνητικές εντολές."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got a code for Pro? Enter it right in the app, on the Pro screen or under Voice Commands."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes un código para Pro? Introdúcelo en la propia app, en la pantalla de Pro o en Comandos de voz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko sinulla koodi Prohon? Syötä se suoraan sovelluksessa Pro-näytöllä tai kohdassa Äänikomennot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as un code pour Pro ? Saisis-le directement dans l’app, sur l’écran Pro ou dans Commandes vocales."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punya kode untuk Pro? Masukkan langsung di aplikasi, di layar Pro atau di Perintah Suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un codice per Pro? Inseriscilo direttamente nell’app, nella schermata Pro o in Comandi vocali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proのコードをお持ちなら、アプリ内のPro画面か「音声コマンド」からそのまま入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 코드가 있나요? Pro 화면이나 음성 명령에서 앱 안에 바로 입력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du en kode for Pro? Skriv den inn rett i appen, på Pro-skjermen eller under Stemmekommandoer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb je een code voor Pro? Voer hem direct in de app in, op het Pro-scherm of bij Spraakcommando’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz kod do Pro? Wpisz go prosto w aplikacji — na ekranie Pro lub w Poleceniach głosowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem um código do Pro? Digite direto no app, na tela do Pro ou em Comandos de voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть код для Pro? Введите его прямо в приложении — на экране Pro или в разделе «Голосовые команды»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du en kod för Pro? Ange den direkt i appen, på Pro-skärmen eller under Röstkommandon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีรหัสสำหรับ Pro ใช่ไหม ป้อนในแอปได้เลย ที่หน้าจอ Pro หรือในคำสั่งเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro için kodunuz mu var? Doğrudan uygulamada, Pro ekranında veya Sesli Komutlar altında girin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có mã dành cho Pro? Nhập ngay trong ứng dụng, tại màn hình Pro hoặc trong Lệnh giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 Pro 兑换码？现在可以直接在 App 里输入，在 Pro 页面或“语音指令”中都可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 Pro 的優惠代碼嗎？直接在 App 內的 Pro 畫面或「語音指令」中輸入。"
          }
        }
      }
    },
