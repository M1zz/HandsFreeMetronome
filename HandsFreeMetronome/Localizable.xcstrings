            "value" : "Skjermen er fortsatt lesbar og ryddig, selv med de aller største tekststørrelsene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het scherm blijft leesbaar en netjes, ook bij de allergrootste tekstgrootte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran pozostaje czytelny i uporządkowany nawet przy największym rozmiarze tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
