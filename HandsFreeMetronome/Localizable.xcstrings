    "Design every click of the measure — high, low, or silent — and save patterns per song." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte každý cvak taktu – vysoký, nízký nebo tichý – a ukládejte vzorce pro jednotlivé skladby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil hvert klik i taktten – højt, lavt eller lydløst – og gem mønstre for hver sang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestalte jeden Klick im Takt – hoch, tief oder stumm – und speichere Muster für jeden Song."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίστε κάθε κλικ του μέτρου — υψηλό, χαμηλό ή σιωπηλό — και αποθηκεύστε μοτίβα για κάθε κομμάτι."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design every click of the bar — high, low, or silent — and save patterns per song."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseña cada clic del compás (agudo, grave o silencio) y guarda patrones para cada canción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta tahdin jokainen naksahdus korkeaksi, matalaksi tai hiljaiseksi ja tallenna kuviot kappaleittain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règle chaque clic de la mesure — aigu, grave ou muet — et enregistre un motif par morceau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur setiap klik dalam birama — tinggi, rendah, atau senyap — dan simpan pola untuk tiap lagu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna ogni click della battuta — acuto, grave o silenzioso — e salva gli schemi per ogni brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小節のクリックをひとつずつ高音・低音・無音に設定し、曲ごとにパターンを保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마디의 모든 클릭을 높은 소리, 낮은 소리, 무음으로 설계하고 곡마다 패턴을 저장하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still inn hvert klikk i takten – høyt, lavt eller stille – og lagre mønstre for hver sang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel elke klik van de maat in — hoog, laag of stil — en bewaar patronen per nummer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw każde kliknięcie taktu — wysokie, niskie lub ciche — i zapisuj wzorce dla każdego utworu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina cada clique do compasso — agudo, grave ou mudo — e salve padrões para cada música."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте каждый клик такта — высокий, низкий или тихий — и сохраняйте рисунки для каждой пьесы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utforma varje klick i takten – högt, lågt eller tyst – och spara mönster för varje låt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดเสียงคลิกทุกจังหวะในห้อง จะสูง ต่ำ หรือเงียบก็ได้ แล้วบันทึกรูปแบบแยกตามเพลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ölçünün her tıkını tiz, pes veya sessiz olarak ayarlayın ve desenleri şarkı başına kaydedin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết kế từng tiếng gõ trong ô nhịp — cao, thấp hoặc im lặng — và lưu mẫu cho từng bài hát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为小节里的每一击设定高音、低音或静音，并按曲目保存重音型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為小節中的每一下點擊設計高音、低音或靜音，並依歌曲儲存節奏型態。"
          }
        }
      }
    },
