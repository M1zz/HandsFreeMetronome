    "At the largest text sizes, buttons and lists rearrange so nothing gets cut off." : {
      "comment" : "What's new 1.0.10: large text detail",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při největších velikostech textu se tlačítka a seznamy přeskládají, aby se nic neořízlo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved de største tekststørrelser omarrangeres knapper og lister, så intet bliver skåret af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei den größten Schriftgrößen ordnen sich Tasten und Listen neu an, damit nichts abgeschnitten wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στα μεγαλύτερα μεγέθη κειμένου, τα κουμπιά και οι λίστες αναδιατάσσονται ώστε να μη κόβεται τίποτα."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the largest text sizes, buttons and lists rearrange so nothing gets cut off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con los tamaños de texto más grandes, los botones y las listas se reorganizan para que nada quede cortado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurimmilla tekstikoilla painikkeet ja luettelot järjestyvät uudelleen, jottei mitään leikkaudu pois."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aux plus grandes tailles de texte, les boutons et les listes se réorganisent pour que rien ne soit coupé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada ukuran teks terbesar, tombol dan daftar ditata ulang agar tidak ada yang terpotong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con le dimensioni di testo più grandi, pulsanti ed elenchi si riorganizzano e niente viene tagliato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "とても大きな文字サイズでは、ボタンやリストの並びが変わり、文字が切れなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 큰 글자 크기에서는 버튼과 목록이 재배치되어 잘리는 곳이 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved de største tekststørrelsene ordnes knapper og lister om slik at ingenting blir kuttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij de grootste tekstgroottes schikken knoppen en lijsten zich anders, zodat niets wordt afgekapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy największych rozmiarach tekstu przyciski i listy układają się inaczej, by nic nie zostało ucięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos maiores tamanhos de texto, botões e listas se reorganizam para nada ficar cortado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При самом крупном тексте кнопки и списки перестраиваются, и ничего не обрезается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid de största textstorlekarna ordnas knappar och listor om så att inget klipps av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อใช้ตัวอักษรขนาดใหญ่ที่สุด ปุ่มและรายการจะจัดเรียงใหม่เพื่อไม่ให้ถูกตัดขาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En büyük yazı boyutlarında düğmeler ve listeler yeniden dizilir, hiçbir şey kesilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở cỡ chữ lớn nhất, các nút và danh sách tự sắp xếp lại để không bị cắt mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用最大字号时，按钮和列表会重新排列，文字不再被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在最大的文字大小下，按鈕與列表會重新排列，不會有東西被截掉。"
          }
        }
      }
    },
