        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es tu tempo como término clásico. Tócalo para pasar al número de BPM y volver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是用古典音乐术语表示的速度。轻点即可在术语和 BPM 数字之间切换。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É o seu andamento com o nome clássico. Toque para trocar pelo número em BPM e voltar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est ton tempo sous son nom classique. Touche-le pour passer au nombre de BPM, et inversement."
          }
        }
      }
    },
    "The app’s own mic is off so it won’t clash with Voice Control. Say “Tap Start”, “Tap Faster”, or “Tap 3 beats”." : {
      "comment" : "A tip for users who have Voice Control enabled.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声コントロールと競合しないよう、アプリのマイクはオフになっています。「スタートをタップ」「速くをタップ」「3拍をタップ」のように話してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikro der App ist aus, damit es der Sprachsteuerung nicht in die Quere kommt. Sag „Tippe auf Start“, „Tippe auf Schneller“ oder „Tippe auf 3 Schläge“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono de la app está apagado para no interferir con Control por voz. Di “Toca Iniciar”, “Toca Más rápido” o “Toca 3 tiempos”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本 App 的麦克风已关闭，不会与语音控制冲突。请说“轻点开始”“轻点加快”或“轻点 3 拍”。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone do app fica desligado para não conflitar com o Controle por Voz. Diga “Toque em Iniciar”, “Toque em Mais rápido” ou “Toque em 3 tempos”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro de l’app est coupé pour ne pas gêner le Contrôle vocal. Dis « Touche Démarrer », « Touche Plus vite » ou « Touche 3 temps »."
          }
        }
      }
    },
    "The full metronome — every tempo, meter, and subdivision — all three beat views, tap tempo, timing check, and complete hands-free voice control." : {
      "comment" : "A description of the full metronome.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あらゆるテンポ・拍子・細分に対応したメトロノーム本体、3種類のビート表示、タップテンポ、タイミングチェック、そして手を使わないフル音声操作。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das komplette Metronom – jedes Tempo, jede Taktart und Unterteilung –, alle drei Beat-Ansichten, Tap-Tempo, Timing-Check und die volle Steuerung per Stimme, ganz ohne Hände."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El metrónomo completo (todos los tempos, compases y subdivisiones), las tres vistas del pulso, tempo por toques, prueba de precisión y control total por voz sin usar las manos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整的节拍器：所有速度、拍号和细分，全部三种节拍视图，敲击定速，节奏准度检测，以及完整的免手动语音控制。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O metrônomo completo — todos os andamentos, compassos e subdivisões —, os três visuais de batida, tap tempo, teste de timing e controle total por voz, sem usar as mãos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le métronome complet — tous les tempos, mesures et subdivisions — les trois vues des temps, le tap tempo, le test de précision et toute la commande vocale mains libres."
          }
        }
      }
    },
    "The mic is already listening — say “start”, “faster”, or “help”. Use iOS Voice Control? Open Voice Commands to switch." : {
      "comment" : "A tip for users who are using a mic for the first time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクはすでに聞き取り中です。「start」「faster」「help」と話してみてください。iOSの音声コントロールを使う場合は、「音声コマンド」を開いて切り替えます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikro hört schon zu – sag „start“, „faster“ oder „help“. Du nutzt die iOS-Sprachsteuerung? Öffne die Sprachbefehle, um umzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono ya está escuchando: di “start”, “faster” o “help”. ¿Usas Control por voz de iOS? Abre Comandos de voz para cambiar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风已在聆听，说“start”“faster”或“help”即可。在用 iOS 语音控制？打开“语音指令”进行切换。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone já está ouvindo — diga “start”, “faster” ou “help”. Usa o Controle por Voz do iOS? Abra Comandos de voz para trocar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro écoute déjà — dis « start », « faster » ou « help ». Tu utilises le Contrôle vocal d’iOS ? Ouvre Commandes vocales pour basculer."
          }
        }
      }
    },
    "The yearly plan auto-renews at %@/year until cancelled at least 24 hours before renewal, in Settings > Apple Account > Subscriptions. Lifetime is a single one-time charge." : {
      "comment" : "A description of the auto-renewal policy of the yearly Pro subscription.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年間プランは、更新日の24時間前までに「設定」>「Apple Account」>「サブスクリプション」で解約しない限り、%@/年で自動更新されます。買い切りは1回限りのお支払いです。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Jahresabo verlängert sich automatisch für %@/Jahr, sofern es nicht spätestens 24 Stunden vor der Verlängerung gekündigt wird – unter Einstellungen > Apple Account > Abonnements. Lebenslang wird nur einmal berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan anual se renueva automáticamente a %@/año salvo que lo canceles al menos 24 horas antes de la renovación, en Ajustes > Cuenta de Apple > Suscripciones. De por vida es un único cargo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年度订阅将按 %@/年自动续订，除非在续订前至少 24 小时于“设置 > Apple 账户 > 订阅”中取消。永久版为一次性付费。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plano anual é renovado automaticamente por %@/ano até ser cancelado com pelo menos 24 horas de antecedência da renovação, em Ajustes > Conta Apple > Assinaturas. O vitalício é uma cobrança única."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abonnement annuel se renouvelle automatiquement à %@/an, sauf résiliation au moins 24 heures avant son renouvellement, dans Réglages > Compte Apple > Abonnements. L’achat à vie est facturé une seule fois."
          }
        }
      }
    },
