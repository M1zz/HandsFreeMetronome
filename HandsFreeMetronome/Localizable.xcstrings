        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a gentle reminder at the time you choose to practice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un aviso a la hora que elijas para practicar."
          }
        },
