        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 큰 글자 크기에서도 화면이 읽기 쉽고 깔끔하게 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
