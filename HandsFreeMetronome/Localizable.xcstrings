    "Your presets and settings follow you between iPhone and iPad." : {
      "comment" : "Roadmap item detail: sync.icloud",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše předvolby a nastavení vás provázejí mezi iPhonem a iPadem."
          }
        },
        "da" : {
          "stringUnit" : {
