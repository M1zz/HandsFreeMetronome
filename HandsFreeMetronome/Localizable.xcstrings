    "Design every click of the measure — high, low, or silent — and save patterns per song." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小節のクリックをひとつずつ高音・低音・無音に設定し、曲ごとにパターンを保存できます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestalte jeden Klick im Takt – hoch, tief oder stumm – und speichere Muster für jeden Song."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseña cada clic del compás (agudo, grave o silencio) y guarda patrones para cada canción."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为小节里的每一击设定高音、低音或静音，并按曲目保存重音型。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina cada clique do compasso — agudo, grave ou mudo — e salve padrões para cada música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règle chaque clic de la mesure — aigu, grave ou muet — et enregistre un motif par morceau."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마디의 모든 클릭을 높은 소리, 낮은 소리, 무음으로 설계하고 곡마다 패턴을 저장하세요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為小節中的每一下點擊設計高音、低音或靜音，並依歌曲儲存節奏型態。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna ogni click della battuta — acuto, grave o silenzioso — e salva gli schemi per ogni brano."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design every click of the measure — high, low, or silent — and save patterns per song."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте каждый клик такта — высокий, низкий или тихий — и сохраняйте рисунки для каждой пьесы."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel elke klik van de maat in — hoog, laag of stil — en bewaar patronen per nummer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw każde kliknięcie taktu — wysokie, niskie lub ciche — i zapisuj wzorce dla każdego utworu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
