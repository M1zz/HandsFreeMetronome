        }
      }
    },
    "Tap to switch between the bouncing ball and the orbit ring — or say “%@” / “%@”." : {
      "comment" : "A description of the action to take to switch between the bouncing ball and the orbit ring.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím přepnete mezi skákajícím míčkem a oběžným kruhem – nebo řekněte „%1$@“ / „%2$@“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
