    "Every click of the measure is its own cell — %lld clicks in all. Tap a cell to cycle it: high → low → silent." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小節内のクリックがそれぞれセルになっています（全%lldクリック）。セルをタップすると高音→低音→無音の順に切り替わります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Klick im Takt ist eine eigene Zelle – insgesamt %lld Klicks. Tippe auf eine Zelle, um sie zu wechseln: hoch → tief → stumm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada clic del compás es una celda: %lld clics en total. Toca una celda para cambiarla: agudo → grave → silencio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小节里的每一击各占一格，共 %lld 击。轻点格子循环切换：高音 → 低音 → 静音。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada clique do compasso tem sua própria célula — %lld cliques no total. Toque numa célula para alternar: agudo → grave → mudo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque clic de la mesure a sa case — %lld clics en tout. Touche une case pour la faire changer : aigu → grave → muet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마디의 클릭 하나하나가 각각의 칸이에요. 총 %lld개예요. 칸을 탭하면 높은 소리 → 낮은 소리 → 무음 순으로 바뀝니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小節中的每一下點擊都是獨立的格子，共 %lld 下。點選格子即可循環切換：高音 → 低音 → 靜音。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni click della battuta ha la sua casella: %lld click in tutto. Tocca una casella per cambiarla: acuto → grave → silenzioso."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every click of the measure is its own cell — %lld clicks in all. Tap a cell to cycle it: high → low → silent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый клик такта — отдельная ячейка, всего их %lld. Нажимайте на ячейку, чтобы переключать: высокий → низкий → тишина."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke klik van de maat heeft een eigen cel — %lld klikken in totaal. Tik op een cel om te wisselen: hoog → laag → stil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde kliknięcie taktu ma własną komórkę — łącznie %lld. Dotknij komórki, aby ją przełączyć: wysoki → niski → cichy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ölçünün her tıkı ayrı bir hücredir; toplam %lld tık var. Değiştirmek için hücreye dokunun: tiz → pes → sessiz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje klick i takten har sin egen ruta – %lld klick totalt. Tryck på en ruta för att växla: hög → låg → tyst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert klik i taktten har sin egen celle – i alt %lld klik. Tryk på en celle for at skifte: høj → lav → lydløs."
          }
        }
      }
    },
