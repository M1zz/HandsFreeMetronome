    "Beat and timing colors stay clear with Increase Contrast, or if colors are hard to tell apart." : {
      "comment" : "Roadmap item detail: a11y.contrast",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げても、色の区別が難しくても、拍やタイミングの色がはっきりわかります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farben für Schläge und Timing bleiben bei erhöhtem Kontrast oder Farbschwäche gut erkennbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los colores del pulso y del timing se distinguen bien con más contraste o si te cuesta diferenciar colores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使开启增强对比度或难以分辨颜色，也能看清节拍和节奏判定的颜色。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cores das batidas e do timing ficam claras com mais contraste ou se você tiver dificuldade com cores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les couleurs des temps et du timing restent nettes avec le contraste accru ou si tu distingues mal les couleurs."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비 증가를 켜거나 색을 구분하기 어려울 때도 박과 타이밍 색상이 또렷해요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「提高對比」，或不易分辨顏色時，拍子與節奏準度的顏色依然清楚。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I colori dei movimenti e del ritmo restano chiari con Aumenta contrasto o se è difficile distinguere i colori."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beat and timing colours stay clear with Increase Contrast, or if colours are hard to tell apart."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвета долей и ритма остаются чёткими при включённом «Увеличении контраста» или если цвета трудно различать."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel- en timingkleuren blijven duidelijk met Verhoog contrast, of als kleuren moeilijk te onderscheiden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolory uderzeń i rytmu pozostają wyraźne po włączeniu opcji Zwiększ kontrast lub gdy trudno odróżnić kolory."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrastı Artır açıkken veya renkleri ayırt etmek zorsa vuruş ve zamanlama renkleri net kalır."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slag- och timingfärger förblir tydliga med Öka kontrast, eller om färger är svåra att skilja åt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slag- og timingfarver forbliver tydelige med Øg kontrast, eller hvis farver er svære at skelne."
          }
        }
      }
    },
