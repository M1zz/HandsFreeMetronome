          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “practice” para subir el tempo automáticamente cada pocos compases mientras tocas. Ideal para ejercicios de velocidad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说“practice”，演奏时每隔几小节自动提速，特别适合练速度。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “practice” para subir o andamento automaticamente a cada poucos compassos enquanto você toca — ótimo para treinar velocidade."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis « practice » pour faire monter le tempo par paliers de quelques mesures pendant que tu joues — idéal pour travailler la vitesse."
