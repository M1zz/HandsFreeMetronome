        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“practice”라고 말하면 연주하는 동안 몇 마디마다 템포가 자동으로 올라가요. 속도 연습에 딱 좋아요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
