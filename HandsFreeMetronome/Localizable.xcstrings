    "Save a pattern per song — recalling it also restores its meter and subdivision." : {
      "comment" : "A description of the saved patterns feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲ごとにパターンを保存できます。呼び出すと拍子と細分も元どおりになります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere ein Muster pro Song – beim Abrufen kommen auch Taktart und Unterteilung zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un patrón por canción: al recuperarlo, también vuelven su compás y su subdivisión."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每首曲子保存重音型，调用时会一并恢复拍号和细分。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve um padrão para cada música — ao carregá-lo, o compasso e a subdivisão voltam junto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre un motif par morceau — le rappeler rétablit aussi sa mesure et sa subdivision."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곡마다 패턴을 저장하세요. 불러오면 박자와 분할도 함께 복원돼요."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依歌曲儲存節奏型態——叫出時也會一併還原拍號與細分。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva uno schema per ogni brano: richiamandolo ripristini anche tempo e suddivisione."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save a pattern per song — recalling it also restores its metre and subdivision."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте рисунок для каждой пьесы: при вызове вернутся также размер и дробление."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar een patroon per nummer — als je het oproept, komen ook de maatsoort en onderverdeling terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj wzorzec dla każdego utworu — po wywołaniu wróci też jego metrum i podział."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarkı başına bir desen kaydedin; çağırdığınızda ölçüsü ve alt bölümü de geri gelir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara ett mönster per låt – när du hämtar det återställs även taktart och underdelning."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem et mønster for hver sang – når du henter det, gendannes også taktart og underdeling."
          }
        }
      }
