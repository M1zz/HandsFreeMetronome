    "Tap the view icon (top-right of the beat card) — bounce → orbit → ring sweep." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na ikonu zobrazení (vpravo nahoře na kartě dob): odraz → oběžná dráha → kruh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på visningsikonet (øverst til højre på slagkortet): hop → kredsløb → ring."
